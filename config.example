# Configuration du Bot Discord
DISCORD_TOKEN=votre_token_bot_discord_ici
CLIENT_ID=votre_client_id_discord_ici

# Configuration Lavalink
LAVALINK_HOST=lava-v4.ajieblogs.eu.org
LAVALINK_PORT=443
LAVALINK_PASSWORD=ajidevserver
LAVALINK_SECURE=true

# Configuration Spotify (optionnel)
SPOTIFY_CLIENT_ID=votre_spotify_client_id_ici
SPOTIFY_CLIENT_SECRET=votre_spotify_client_secret_ici

# Configuration du Bot
PREFIX=+
REGISTER_SLASH=true
DJ_ROLE_NAME=DJ
PADD_COOLDOWN_SECONDS=5

# Configuration des Plugins
AUTODJ_ENABLED=true
SMARTQUEUE_ENABLED=true
VOICEEFFECTS_ENABLED=true
